<%- include('partials/header') %>

<!-- ══════════════════════════════════════════════════
     TOAST NOTIFICATION SYSTEM
══════════════════════════════════════════════════ -->
<style>
    /* ── Toast ── */
    @keyframes toastIn  { from { opacity:0; transform:translateY(24px) scale(.95); } to { opacity:1; transform:translateY(0) scale(1); } }
    @keyframes toastOut { from { opacity:1; transform:translateY(0) scale(1); }      to { opacity:0; transform:translateY(24px) scale(.95); } }
    @keyframes progressBar { from { width:100%; } to { width:0%; } }
    @keyframes cardEntrance { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }

    #toast-wrap {
        position: fixed;
        bottom: 28px;
        right: 28px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
        pointer-events: none;
    }
    .toast-item {
        pointer-events: auto;
        min-width: 280px;
        max-width: 360px;
        padding: 13px 16px 16px;
        border-radius: 12px;
        border: 1px solid;
        backdrop-filter: blur(12px);
        animation: toastIn .35s cubic-bezier(.22,1,.36,1) both;
        position: relative;
        overflow: hidden;
    }
    .toast-item.hide { animation: toastOut .3s ease both; }
    .toast-icon-title { display:flex; align-items:center; gap:9px; margin-bottom:3px; }
    .toast-icon { font-size:1.1rem; line-height:1; flex-shrink:0; }
    .toast-title { font-weight:600; font-size:14px; }
    .toast-sub { font-size:12.5px; opacity:.75; margin-left:28px; }
    .toast-bar {
        position:absolute;
        bottom:0; left:0;
        height:3px;
        border-radius:0 0 12px 12px;
        animation: progressBar 4s linear both;
    }
    /* success */
    .toast-success { background:rgba(22,163,74,.15); border-color:rgba(34,197,94,.3); color:#4ade80; }
    .toast-success .toast-bar { background:#22c55e; }
    /* error */
    .toast-error   { background:rgba(220,38,38,.13); border-color:rgba(239,68,68,.3); color:#f87171; }
    .toast-error   .toast-bar { background:#ef4444; }
    /* info */
    .toast-info    { background:rgba(59,130,246,.13); border-color:rgba(99,165,255,.3); color:#60a5fa; }
    .toast-info    .toast-bar { background:#3b82f6; }

    /* ── Card entrance stagger ── */
    .task-card { animation: cardEntrance .4s ease both; }

    /* ── Locked badge ── */
    .locked-badge {
        display:inline-flex; align-items:center; gap:5px;
        font-size:11px; font-weight:600;
        color:#f59e0b; background:rgba(245,158,11,.12);
        border:1px solid rgba(245,158,11,.3);
        border-radius:999px; padding:3px 9px;
    }

    /* ── Own-task label ── */
    .owner-chip {
        display:inline-flex; align-items:center; gap:4px;
        font-size:11px; font-weight:600;
        color:var(--accent); background:var(--blue-bg);
        border:1px solid var(--accent-dim);
        border-radius:999px; padding:3px 9px;
    }
    .tasker-chip {
        display:inline-flex; align-items:center; gap:4px;
        font-size:11px; font-weight:600;
        color:var(--warning); background:var(--warning-bg);
        border:1px solid rgba(245,166,35,.3);
        border-radius:999px; padding:3px 9px;
    }

    /* ── Bounty gradient ── */
    .task-bounty-grad {
        font-size:.95rem; font-weight:700; white-space:nowrap;
        background: linear-gradient(135deg,#22c97a,#3b7de8);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        background-clip: text;
        padding: 3px 0;
    }

    /* ── Empty state ── */
    .empty-state {
        display:flex; flex-direction:column; align-items:center;
        padding: 4rem 2rem; gap:1rem;
        background:var(--bg-card); border:1px solid var(--border);
        border-radius:16px; margin-top:2rem; text-align:center;
    }
    .empty-icon { font-size:3.2rem; line-height:1; }
    .empty-title { font-family:'Syne',sans-serif; font-size:1.35rem; font-weight:700; color:var(--text-primary); margin:0; }
    .empty-sub { font-size:14px; color:var(--text-muted); margin:0; }

    /* ── Delete confirm dialog ── */
    @keyframes confirmIn { from{opacity:0;transform:scale(.93)} to{opacity:1;transform:scale(1)} }
    #confirm-overlay {
        display:none; position:fixed; inset:0; z-index:8888;
        background:rgba(8,13,26,.85); backdrop-filter:blur(10px);
        align-items:center; justify-content:center;
    }
    #confirm-overlay.open { display:flex; }
    #confirm-box {
        background:var(--bg-card); border:1px solid var(--border);
        border-radius:16px; padding:2rem 1.8rem; max-width:380px; width:90%;
        text-align:center; animation:confirmIn .25s ease both;
        box-shadow:0 0 40px rgba(0,0,0,.5);
    }
    #confirm-box h3 { font-family:'Syne',sans-serif; font-size:1.1rem; margin:0 0 .4rem; color:var(--text-primary); }
    #confirm-box p  { font-size:13.5px; color:var(--text-secondary); margin:0 0 1.6rem; }
    .confirm-actions { display:flex; gap:.75rem; justify-content:center; }
    .confirm-cancel {
        padding:.6rem 1.4rem; border-radius:9px; font-size:13.5px; font-weight:600;
        border:1px solid var(--border); background:var(--bg-surface);
        color:var(--text-secondary); cursor:pointer;
        transition:background .15s, color .15s;
    }
    .confirm-cancel:hover { background:var(--bg-card-hover); color:var(--text-primary); }
    .confirm-delete {
        padding:.6rem 1.4rem; border-radius:9px; font-size:13.5px; font-weight:600;
        border:none; background:var(--danger); color:#fff; cursor:pointer;
        transition:opacity .15s, transform .1s;
    }
    .confirm-delete:hover { opacity:.88; transform:translateY(-1px); }

    /* ── Delete btn style ── */
    .btn-delete {
        display:inline-flex; align-items:center; gap:6px;
        font-family:'DM Sans',sans-serif; font-size:13px; font-weight:500;
        padding:7px 16px; border-radius:7px;
        border:1px solid rgba(232,80,91,.45);
        background:var(--danger-bg); color:var(--danger);
        cursor:pointer; transition:background .15s, box-shadow .15s, transform .1s;
    }
    .btn-delete:hover { background:rgba(232,80,91,.18); box-shadow:0 0 10px rgba(232,80,91,.15); }
    .btn-delete:active { transform:scale(.97); }
</style>

<!-- ══ Toast Container ══ -->
<div id="toast-wrap"></div>

<!-- ══ Delete Confirm Dialog ══ -->
<div id="confirm-overlay">
    <div id="confirm-box">
        <h3>🗑️ Delete Task?</h3>
        <p>Are you sure you want to delete this task?<br>This action cannot be undone.</p>
        <div class="confirm-actions">
            <button class="confirm-cancel" onclick="closeConfirm()">Cancel</button>
            <button class="confirm-delete" id="confirm-delete-btn">Yes, Delete</button>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════
     PAGE CONTENT
══════════════════════════════════════════════════ -->
<div style="padding-bottom: 3rem;">
    <div class="page-header">
        <h1>All <span>Tasks</span></h1>

        <a href="/tasks/new" class="btn-primary-custom">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            New Task
        </a>
    </div>

    <% if (tasks && tasks.length > 0) { %>

        <% tasks.forEach((task, i) => { %>
        <div class="task-card" style="animation-delay: <%= i * 60 %>ms">

            <div class="task-card-top">
                <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                    <h5 class="task-title"><%= task.title %></h5>
                    <% if (task.status === 'Completed') { %>
                        <span class="locked-badge">
                            <svg width="9" height="9" viewBox="0 0 12 12" fill="none">
                                <rect x="2" y="5" width="8" height="6" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
                                <path d="M4 5V3.5a2 2 0 014 0V5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                            </svg>
                            Locked
                        </span>
                    <% } %>
                </div>

                <% if (task.bounty) { %>
                    <span class="task-bounty-grad">₹<%= Number(task.bounty).toLocaleString('en-IN') %></span>
                <% } else { %>
                    <span style="font-size:.82rem; color:var(--text-muted); white-space:nowrap;">No bounty</span>
                <% } %>
            </div>

            <p class="task-desc"><%= task.description || 'No description provided.' %></p>

            <div class="task-meta">
                <%
                    let statusClass = 'status-open';
                    if (task.status === 'Claimed')   statusClass = 'status-claimed';
                    if (task.status === 'Completed') statusClass = 'status-completed';
                %>

                <span class="status-badge <%= statusClass %>"><%= task.status %></span>

                <%
                    const isOwner  = task.requester && userId && String(task.requester._id) === String(userId);
                    const isClaimer = task.tasker && userId && String(task.tasker._id) === String(userId);
                %>

                <% if (isOwner) { %>
                    <span class="owner-chip">
                        <svg width="9" height="9" viewBox="0 0 12 12" fill="none">
                            <circle cx="6" cy="3.5" r="2" stroke="currentColor" stroke-width="1.3"/>
                            <path d="M1.5 10c0-2.21 2.015-4 4.5-4s4.5 1.79 4.5 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                        </svg>
                        Posted by you
                    </span>
                <% } else { %>
                    <span class="meta-chip">
                        <svg width="11" height="11" viewBox="0 0 12 12" fill="none">
                            <circle cx="6" cy="4" r="2.5" stroke="currentColor" stroke-width="1.3"/>
                            <path d="M1.5 10.5c0-2.485 2.015-4.5 4.5-4.5s4.5 2.015 4.5 4.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                        </svg>
                        <strong>By:</strong> <%= task.requester?.username || "Unknown" %>
                    </span>
                <% } %>

                <% if (isClaimer) { %>
                    <span class="tasker-chip">
                        <svg width="9" height="9" viewBox="0 0 12 12" fill="none">
                            <path d="M2 6.5l3 3 5-6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        You claimed this
                    </span>
                <% } else if (task.tasker) { %>
                    <span class="meta-chip">
                        <svg width="11" height="11" viewBox="0 0 12 12" fill="none">
                            <path d="M6 1l1.3 2.6 2.9.4-2.1 2 .5 2.9L6 7.6 3.4 9l.5-2.9L1.8 4l2.9-.4z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                        </svg>
                        <strong>Tasker:</strong> <%= task.tasker.username %>
                    </span>
                <% } %>
            </div>

            <div class="task-actions">

                <% if (task.status === 'Open') { %>

                    <!-- CLAIM (only for non-owners) -->
                    <% if (!isOwner) { %>
                        <form action="/tasks/<%= task._id %>/claim" method="POST">
                            <button type="submit" class="btn-action btn-claim">
                                <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
                                    <path d="M2 7l4 4 6-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                Claim Task
                            </button>
                        </form>
                    <% } %>

                    <!-- DELETE (only for owner, with confirmation) -->
                    <% if (isOwner) { %>
                        <button class="btn-delete" onclick="confirmDelete('<%= task._id %>')">
                            <svg width="12" height="12" viewBox="0 0 14 14" fill="none">
                                <path d="M1 3h12M5 3V2h4v1M3 3l1 9h6l1-9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            Delete
                        </button>
                    <% } %>

                <% } else if (task.status === 'Claimed' || task.status === 'Completed') { %>

                    <% if (task.status === 'Claimed') { %>
                        <span class="done-tag" style="background:var(--bg-surface); padding:7px 14px; border-radius:7px; border:1px solid var(--border);">
                            ⏳ In Progress
                        </span>
                    <% } %>

                    <!-- Requester sees tasker phone -->
                    <% if (isOwner && task.tasker) { %>
                        <div class="contact-box">
                            <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
                                <path d="M2 2h4l1.5 3.5-2 1.2a7.5 7.5 0 003.8 3.8l1.2-2L14 10v4a2 2 0 01-2 0C5.37 13.5.5 8.63.5 2a2 2 0 010-2z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
                            </svg>
                            <%= task.tasker.phone || "No phone available" %>
                        </div>
                    <% } %>

                    <!-- Mark Complete (only tasker, only while Claimed) -->
                    <% if (task.status === 'Claimed' && isClaimer) { %>
                        <form action="/tasks/<%= task._id %>/complete" method="POST">
                            <button class="btn-action btn-complete" type="submit">
                                <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
                                    <path d="M2 7l4 4 6-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                Mark Complete
                            </button>
                        </form>
                    <% } %>

                    <% if (task.status === 'Completed') { %>
                        <span class="done-tag">
                            <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
                                <path d="M2 7l4 4 6-7" stroke="#22c97a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            Completed
                        </span>
                    <% } %>

                <% } %>

            </div>

        </div>
        <% }) %>

    <% } else { %>

        <!-- ══ SMART EMPTY STATE ══ -->
        <div class="empty-state">
            <div class="empty-icon">👀</div>
            <h2 class="empty-title">No tasks yet</h2>
            <p class="empty-sub">Be the first to post one!</p>
            <a href="/tasks/new" class="btn-primary-custom" style="margin-top:.5rem;">
                <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
                    <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                Post a Task
            </a>
        </div>

    <% } %>

</div>

<!-- ══════════════════════════════════════════════════
     JAVASCRIPT: Toasts + Delete Confirm
══════════════════════════════════════════════════ -->
<script>
// ── Toast engine ──────────────────────────────────────────────────────────
const TOASTS = {
    created:   { type:'success', icon:'✅', title:'Task Created!',   sub:'Your task is now live.' },
    claimed:   { type:'info',    icon:'🚀', title:'Task Claimed!',   sub:'Good luck completing it.' },
    completed: { type:'success', icon:'🏁', title:'Task Completed!', sub:'Well done — it\'s marked as done.' },
    deleted:   { type:'error',   icon:'🗑️', title:'Task Deleted',    sub:'The task has been removed.' },
};

function showToast(cfg) {
    const wrap = document.getElementById('toast-wrap');
    const el = document.createElement('div');
    el.className = `toast-item toast-${cfg.type}`;
    el.innerHTML = `
        <div class="toast-icon-title">
            <span class="toast-icon">${cfg.icon}</span>
            <span class="toast-title">${cfg.title}</span>
        </div>
        <div class="toast-sub">${cfg.sub}</div>
        <div class="toast-bar"></div>
    `;
    wrap.appendChild(el);
    setTimeout(() => { el.classList.add('hide'); setTimeout(() => el.remove(), 350); }, 4000);
}

function showErrorToast(msg) {
    const wrap = document.getElementById('toast-wrap');
    const el = document.createElement('div');
    el.className = 'toast-item toast-error';
    el.innerHTML = `
        <div class="toast-icon-title">
            <span class="toast-icon">❌</span>
            <span class="toast-title">Error</span>
        </div>
        <div class="toast-sub">${msg}</div>
        <div class="toast-bar"></div>
    `;
    wrap.appendChild(el);
    setTimeout(() => { el.classList.add('hide'); setTimeout(() => el.remove(), 350); }, 5000);
}

// ── Fire toasts from URL params ───────────────────────────────────────────
const p = new URLSearchParams(window.location.search);
const flashKey = p.get('flash');
const flashErr = p.get('error');

if (flashKey && TOASTS[flashKey]) showToast(TOASTS[flashKey]);
if (flashErr) showErrorToast(decodeURIComponent(flashErr));

// Clean params from URL without reload
if (flashKey || flashErr) {
    history.replaceState(null, '', window.location.pathname);
}

// ── Delete confirmation ───────────────────────────────────────────────────
let _deleteFormAction = null;

function confirmDelete(taskId) {
    _deleteFormAction = `/tasks/${taskId}?_method=DELETE`;
    document.getElementById('confirm-overlay').classList.add('open');
}

function closeConfirm() {
    document.getElementById('confirm-overlay').classList.remove('open');
    _deleteFormAction = null;
}

document.getElementById('confirm-delete-btn').addEventListener('click', () => {
    if (!_deleteFormAction) return;
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = _deleteFormAction;
    document.body.appendChild(form);
    form.submit();
});

// Close on overlay click
document.getElementById('confirm-overlay').addEventListener('click', (e) => {
    if (e.target === document.getElementById('confirm-overlay')) closeConfirm();
});
</script>

<%- include('partials/footer') %>